# ============================================================
# MOS v5.0 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Supabase ---
# Your Supabase project URL (found in Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key (full access — server/n8n only, never expose client-side)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key (public, safe for client-side read-only)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Notion ---
# Notion integration token (Internal Integration > Secrets)
NOTION_API_KEY=secret_...

# ID of your Notion video database (found in the database URL)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenRouter (Script Agent LLM) ---
# OpenRouter API key (openrouter.ai > Keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use for script generation (e.g. anthropic/claude-sonnet-4-6)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# System prompt for the Script Agent (paste full content or path)
VIDEO_SCRIPT_SYSTEM_PROMPT=You are an expert video script writer...

# --- ComfyUI (Image Generation) ---
# Base URL of your ComfyUI instance (no trailing slash)
COMFYUI_BASE_URL=http://your-vps-ip:8188

# --- fal.ai (Video Generation) ---
# fal.ai API key (fal.ai > Dashboard > Keys)
FAL_API_KEY=fal_...

# --- Blotato (Social Media Publishing) ---
# Blotato API key (blotato.com > Settings > API)
BLOTATO_API_KEY=...

# --- n8n & Webhooks ---
# Your n8n instance base URL (no trailing slash)
N8N_BASE_URL=https://your-n8n-instance.com

# Secret used to authenticate internal webhook calls
# Generate with: openssl rand -hex 32
MOS_WEBHOOK_SECRET=your-random-secret-here

# Public base URL for webhooks (used by fal.ai to call back)
PUBLIC_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook
