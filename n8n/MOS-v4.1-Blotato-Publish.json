    "platforms_supported": [
      "instagram_reels", "tiktok", "youtube_shorts",
      "facebook_reels", "linkedin", "twitter"
    ],
    "scheduling": "Si scheduled_at est dans le futur → Blotato planifie. Sinon → publication immédiate",
    "idempotent_guard": "Validate & Prepare bloque si statut = published ou scheduled avec post_id existant"
  }
