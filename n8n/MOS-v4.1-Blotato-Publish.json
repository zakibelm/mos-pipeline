          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ p_client_id: $json.client_id, p_lock_type: 'blotato_publish', p_locked_by: $execution.id, p_ttl_minutes: 10 }) }}"
      },
      "id": "b004dd44-ee55-ff66-7788-990011223344",
