        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ url: $node['Validate & Prepare'].json.video_url, type: 'video', thumbnail_url: $node['Validate & Prepare'].json.thumbnail_url }) }}"
      },
