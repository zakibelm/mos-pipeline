        "jsonBody": "={{ JSON.stringify({ p_video_id: $node['Build Post Payload'].json.video_id, p_action: $node['Build Post Payload'].json.is_future ? 'post_schedule' : 'post_publish', p_blotato_media_id: $node['Build Post Payload'].json.media_id, p_blotato_post_id: $json.post_id || $json.id || null, p_platform: $node['Build Post Payload'].json.platforms.join(','), p_request_payload: $node['Build Post Payload'].json.payload, p_response_payload: $json, p_success: !!($json.post_id || $json.id), p_cost_cad: $node['Build Post Payload'].json.cost_cad }) }}"
      },
      "id": "b013aa33-4455-6677-8899-001122334455",
      "name": "Log Post Creation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2820, 300]
    },
    {
      "parameters": {
        "mode": "expression",
        "output": "={{ $node['Build Post Payload'].json.is_future ? 0 : 1 }}",
        "cases": [
          { "value": 0, "output": 0 },
          { "value": 1, "output": 1 }
        ],
        "fallbackOutput": 1
      },
      "id": "b014bb44-5566-7788-9900-112233445566",
