      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1380, 420]
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": { "values": [] },
        "options": {}
      },
      "id": "b010dd00-ee11-2233-4455-667788990011",
      "name": "Merge Media ID",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2100, 300]
    },
    {
      "parameters": {
        "mode": "code",
        "jsCode": "// Construit le payload post Blotato\nconst prep      = $node['Validate & Prepare'].json;\nconst mediaId   = $json.resolved_media_id;\n\nif (!mediaId) throw new Error('No media_id resolved — upload may have failed');\n\nconst payload = {\n  media_ids:    [mediaId],\n  caption:      prep.caption,\n  platforms:    prep.platforms,\n  // Planifié ou immédiat\n  ...(prep.scheduled_at ? { scheduled_at: prep.scheduled_at } : {})\n};\n\n// Coût estimé Blotato (configurable)\nconst costPerPost = parseFloat(process.env.BLOTATO_COST_PER_POST_CAD || '0.05');\n\nreturn [{\n  json: {\n    video_id:       prep.video_id,\n    client_id:      prep.client_id,\n    notion_page_id: prep.notion_page_id,\n    media_id:       mediaId,\n    platforms:      prep.platforms,\n    is_future:      prep.is_future,\n    scheduled_at:   prep.scheduled_at,\n    payload,\n    cost_cad:       costPerPost\n  }\n}];"
      },
      "id": "b011ee11-2233-4455-6677-889900112233",
      "name": "Build Post Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2340, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BLOTATO_API_URL }}/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.BLOTATO_API_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "id": "b012ff22-3344-5566-7788-990011223344",
      "name": "Create or Schedule Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2580, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/log_blotato_action",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
