    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "mos-pipeline" },
  "tags": [{ "name": "MOS-v4.1" }],
  "__mos_config": {
    "env_required": [
      "SUPABASE_URL", "SUPABASE_SERVICE_KEY",
      "BLOTATO_API_URL", "BLOTATO_API_KEY",
      "NOTION_API_KEY"
    ],
