        "jsonBody": "={{ JSON.stringify({ p_video_id: $node['Build Post Payload'].json.video_id, p_post_id: $node['Create or Schedule Post'].json.post_id || $node['Create or Schedule Post'].json.id, p_scheduled_at: $node['Build Post Payload'].json.scheduled_at, p_cost_cad: $node['Build Post Payload'].json.cost_cad }) }}"
      },
      "id": "b015cc55-6677-8899-0011-223344556677",
