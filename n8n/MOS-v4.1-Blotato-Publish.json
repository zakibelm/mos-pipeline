      "id": "b001aa11-bb22-cc33-dd44-ee5566778899",
      "name": "Blotato Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 300],
      "webhookId": "mos-blotato-publish"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/get_blotato_publish_context",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ p_video_id: $json.video_id }) }}"
      },
      "id": "b002bb22-cc33-dd44-ee55-ff6677889900",
      "name": "Get Publish Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "mode": "code",
        "jsCode": "// Valide que la vidéo est prête pour publication\nconst ctx = $input.first().json[0];\n\nif (!ctx) throw new Error(`Video not found: ${$node['Blotato Webhook'].json.video_id}`);\n\nif (!ctx.video_url) {\n  throw new Error(`video_url is empty for video ${ctx.video_id} — run fal.ai sprint first`);\n}\n\nif (ctx.statut === 'published') {\n  throw new Error(`Video ${ctx.video_id} already published (post_id: ${ctx.blotato_post_id}) — skipping`);\n}\n\nif (ctx.statut === 'scheduled' && ctx.blotato_post_id) {\n  throw new Error(`Video ${ctx.video_id} already scheduled (post_id: ${ctx.blotato_post_id}) — skipping`);\n}\n\n// Construit la caption finale\nconst caption = ctx.script_caption\n  || [ctx.script_hook, ctx.script_cta].filter(Boolean).join('\\n\\n')\n  || ctx.title\n  || 'Nouveau contenu';\n\n// Mapping plateformes MOS → Blotato\nconst platformRaw = (ctx.platform || 'instagram').toLowerCase();\nconst platformMap = {\n  'instagram':        'instagram_reels',\n  'instagram_reels':  'instagram_reels',\n  'instagram reels':  'instagram_reels',\n  'tiktok':           'tiktok',\n  'youtube':          'youtube_shorts',\n  'youtube_shorts':   'youtube_shorts',\n  'youtube shorts':   'youtube_shorts',\n  'facebook':         'facebook_reels',\n  'facebook reels':   'facebook_reels',\n  'linkedin':         'linkedin',\n  'twitter':          'twitter',\n  'x':                'twitter'\n};\n\n// Supporte multi-plateforme (séparé par virgule)\nconst platforms = platformRaw\n  .split(',')\n  .map(p => platformMap[p.trim()] || 'instagram_reels')\n  .filter((v, i, a) => a.indexOf(v) === i); // unique\n\n// Détermine si publication immédiate ou planifiée\nconst scheduledAt = ctx.scheduled_at ? new Date(ctx.scheduled_at) : null;\nconst isFuture    = scheduledAt && scheduledAt > new Date();\n\nreturn [{\n  json: {\n    video_id:          ctx.video_id,\n    client_id:         ctx.client_id,\n    notion_page_id:    ctx.notion_page_id,\n    title:             ctx.title,\n    video_url:         ctx.video_url,\n    thumbnail_url:     ctx.thumbnail_url || null,\n    caption:           caption.substring(0, 2200), // Blotato cap\n    platforms,\n    is_future:         isFuture,\n    scheduled_at:      isFuture ? ctx.scheduled_at : null,\n    existing_media_id: ctx.existing_media_id || null\n  }\n}];"
      },
      "id": "b003cc33-dd44-ee55-ff66-778899001122",
      "name": "Validate & Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
