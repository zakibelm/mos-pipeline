      "typeVersion": 4.2,
      "position": [3780, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: $node['Build Post Payload'].json.is_future ? 'scheduled' : 'published', post_id: $node['Create or Schedule Post'].json.post_id || $node['Create or Schedule Post'].json.id, platforms: $node['Build Post Payload'].json.platforms, scheduled_at: $node['Build Post Payload'].json.scheduled_at || null }) }}",
        "options": { "responseCode": 202 }
      },
      "id": "b019aa99-0011-2233-4455-667788990011",
      "name": "Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [4020, 300]
    }
  ],
